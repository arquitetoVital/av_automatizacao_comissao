# Renomeie este arquivo para .env e preencha com suas credenciais.
# NUNCA commite o arquivo .env no repositório.

MODO_AUTO=#true/false
MODO_TESTE=#true/false — quando true, banco roda em memória (sem persistir no .db)

OMIE_APP_KEY=seu_app_key_aqui
OMIE_APP_SECRET=seu_app_secret_aqui

COMISSOES_FIXAS_PATH=caminho do arquivo comissoes_fixas.xlsx

GITHUB_TOKEN=Personal Access Token com escopo "Contents: Read & Write"
GITHUB_REPO =ex: "minha-org/meu-repo-privado"
GITHUB_BRANCH=branch de destino (padrão: "main")
GITHUB_JSON_PATH=caminho do arquivo no repo (padrão: "data/{ANO_MES}.json")

PASTA_COORD=
PASTA_VENDEDOR_SP=
PASTA_VENDEDOR_MG=
PASTA_COMPRADOR=

PASTA_ANALISTA=
ANALISE_SIMULADOR_PATH=\...\ANALISE_SIMULADOR.xlsx
PASTA_ANALISTA_SIMULADORES=
RELATORIO_ANALISTA_ATIVO=#true/false
BLOQUEIO_NF_ATIVO=#true/false — true=zera comissão + motivo | false=só registra motivo (padrão: true)

# Supabase — filtro de manifestações de NFs
# O script consulta faturamento.faturamento_consolidado e remove das planilhas
# e do JSON as NFs cujas manifestações não são válidas.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua_service_role_key
